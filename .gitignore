# --- Build, package, coverage, and downloaded runtime output ---
/out/
/vd/
/Testing/
/vcpkg_installed/
/_deps/

# Per-user CMake and IDE state
/CMakeUserPresets.json
/.vs/
/.vscode/
/.idea/
/.clangd/
*.suo
*.user
*.VC.db
*.VC.opendb

# Stray compiler/linker artifacts from ad-hoc probes at the repository root
/*.obj
/*.pdb

# Generated CMake files if a developer configures in the source tree by mistake
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/CPackConfig.cmake
/CPackSourceConfig.cmake
/compile_commands.json
/install_manifest.txt
/build.ninja
/.ninja_deps
/.ninja_log

# --- Local tool state ---
.claude/
**/.serena/

# Neutralized nested repositories (local history backups, not for upload;
# rename a folder back to .git to restore that project's standalone repo)
**/.git.bak/

# --- Operating-system metadata ---
.DS_Store
Thumbs.db
Desktop.ini
/nul
