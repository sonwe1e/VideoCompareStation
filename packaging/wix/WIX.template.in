<?xml version="1.0" encoding="UTF-8"?>

<?include "cpack_variables.wxi"?>

<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"@DVS_CPACK_WIX_CUSTOM_XMLNS_PLACEHOLDER@
    RequiredVersion="4.0"
    >

    <Package
        Name="$(var.CPACK_PACKAGE_NAME)"
        Version="$(var.CPACK_PACKAGE_VERSION)"
        Manufacturer="$(var.CPACK_PACKAGE_VENDOR)"
        UpgradeCode="$(var.CPACK_WIX_UPGRADE_GUID)"
        ProductCode="$(var.CPACK_WIX_PRODUCT_GUID)"
        Scope="$(var.CPACK_WIX_INSTALL_SCOPE)"
        InstallerVersion="500"
        Language="1033"
        Codepage="65001"
        Compressed="yes"
        >

        <?ifndef CPACK_WIX_CAB_PER_COMPONENT?>
        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>
        <?endif?>

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="no"
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>

        <WixVariable Id="WixUILicenseRtf" Value="$(var.CPACK_WIX_LICENSE_RTF)"/>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_ROOT"/>

        <?ifdef CPACK_WIX_PRODUCT_ICON?>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
        <Icon Id="ProductIcon.ico" SourceFile="$(var.CPACK_WIX_PRODUCT_ICON)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_BANNER?>
        <WixVariable Id="WixUIBannerBmp" Value="$(var.CPACK_WIX_UI_BANNER)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_DIALOG?>
        <WixVariable Id="WixUIDialogBmp" Value="$(var.CPACK_WIX_UI_DIALOG)"/>
        <?endif?>

        <DirectoryRef Id="INSTALL_ROOT">
            <Component
                Id="CompareStationExplorerCommand"
                Guid="D20DA233-4317-45D8-B878-00BF4486F1C4"
                Bitness="always64">
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\CLSID\{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}"
                    Value="CompareStation Explorer comparison command"
                    Type="string"
                    KeyPath="yes"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\CLSID\{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}\InprocServer32"
                    Value="[INSTALL_ROOT]@DVS_SHELL_BINARY_NAME@"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\CLSID\{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}\InprocServer32"
                    Name="ThreadingModel"
                    Value="Apartment"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mp4\shell\CompareStation.Compare"
                    Name="MUIVerb"
                    Value="Compare with CompareStation"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mp4\shell\CompareStation.Compare"
                    Name="ExplorerCommandHandler"
                    Value="{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mp4\shell\CompareStation.Compare"
                    Name="MultiSelectModel"
                    Value="Player"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mkv\shell\CompareStation.Compare"
                    Name="MUIVerb"
                    Value="Compare with CompareStation"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mkv\shell\CompareStation.Compare"
                    Name="ExplorerCommandHandler"
                    Value="{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mkv\shell\CompareStation.Compare"
                    Name="MultiSelectModel"
                    Value="Player"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mov\shell\CompareStation.Compare"
                    Name="MUIVerb"
                    Value="Compare with CompareStation"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mov\shell\CompareStation.Compare"
                    Name="ExplorerCommandHandler"
                    Value="{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mov\shell\CompareStation.Compare"
                    Name="MultiSelectModel"
                    Value="Player"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.avi\shell\CompareStation.Compare"
                    Name="MUIVerb"
                    Value="Compare with CompareStation"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.avi\shell\CompareStation.Compare"
                    Name="ExplorerCommandHandler"
                    Value="{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.avi\shell\CompareStation.Compare"
                    Name="MultiSelectModel"
                    Value="Player"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.m4v\shell\CompareStation.Compare"
                    Name="MUIVerb"
                    Value="Compare with CompareStation"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.m4v\shell\CompareStation.Compare"
                    Name="ExplorerCommandHandler"
                    Value="{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}"
                    Type="string"/>
                <RegistryValue
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.m4v\shell\CompareStation.Compare"
                    Name="MultiSelectModel"
                    Value="Player"
                    Type="string"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\CLSID\{3B790D74-E76E-4F28-A51D-2AB8C6BD107D}"
                    Action="removeOnUninstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mp4\shell\CompareStation.Compare"
                    Action="removeOnUninstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mkv\shell\CompareStation.Compare"
                    Action="removeOnUninstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.mov\shell\CompareStation.Compare"
                    Action="removeOnUninstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.avi\shell\CompareStation.Compare"
                    Action="removeOnUninstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\SystemFileAssociations\.m4v\shell\CompareStation.Compare"
                    Action="removeOnUninstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\.dvsproj"
                    Action="removeOnInstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\CompareStation.Project"
                    Action="removeOnInstall"/>
                <RemoveRegistryKey
                    Root="HKLM"
                    Key="Software\Classes\Applications\CompareStation.exe\SupportedTypes"
                    Action="removeOnInstall"/>
            </Component>
        </DirectoryRef>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="CompareStationProgramMenuFolder" Name="CompareStation">
                <Component
                    Id="CompareStationStartMenuShortcut"
                    Guid="6DD95669-3B96-4888-B35D-0C3F7F777AD5"
                    Bitness="always64">
                    <Shortcut
                        Id="CompareStationStartMenuEntry"
                        Name="CompareStation"
                        Description="CompareStation"
                        Target="[INSTALL_ROOT]CompareStation.exe"
                        WorkingDirectory="INSTALL_ROOT"/>
                    <RemoveFolder
                        Id="RemoveCompareStationProgramMenuFolder"
                        Directory="CompareStationProgramMenuFolder"
                        On="uninstall"/>
                    <RegistryValue
                        Root="HKCU"
                        Key="Software\CompareStation\Installer"
                        Name="StartMenuShortcut"
                        Value="1"
                        Type="integer"
                        KeyPath="yes"/>
                </Component>
            </Directory>
        </StandardDirectory>

        <FeatureRef Id="ProductFeature">
            <ComponentRef Id="CompareStationExplorerCommand"/>
            <ComponentRef Id="CompareStationStartMenuShortcut"/>
        </FeatureRef>

        <ui:WixUI Id="$(var.CPACK_WIX_UI_REF)" />
        <UIRef Id="WixUI_ErrorProgressText" />

        <?include "properties.wxi"?>
        <?include "product_fragment.wxi"?>
    </Package>
</Wix>
