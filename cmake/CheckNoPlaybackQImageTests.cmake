cmake_minimum_required(VERSION 4.4)

if(NOT DEFINED DVS_TEST_ROOT OR DVS_TEST_ROOT STREQUAL "")
    message(FATAL_ERROR "DVS_TEST_ROOT is required.")
endif()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef runId)
set(checkCount 0)
foreach(case clean missing-relay relay-qimage graphics-qimage)
    math(EXPR checkCount "${checkCount} + 1")
    set(fixtureRoot "${DVS_TEST_ROOT}/${runId}/${case}")
    set(relayHeader "${fixtureRoot}/src/ui_qml/include/dvs/ui/RenderAckRelay.h")
    set(relaySource "${fixtureRoot}/src/ui_qml/src/comparison/RenderAckRelay.cpp")
    set(graphicsSource "${fixtureRoot}/src/platform_windows/src/graphics/GpuTransferActor.cpp")
    file(WRITE "${relayHeader}" "// relay header\n")
    if(NOT case STREQUAL "missing-relay")
        file(WRITE "${relaySource}" "// relay implementation\n")
    endif()
    file(WRITE "${graphicsSource}" "// graphics implementation\n")
    if(case STREQUAL "relay-qimage")
        file(APPEND "${relaySource}" "// QImage\n")
    elseif(case STREQUAL "graphics-qimage")
        file(APPEND "${graphicsSource}" "// QImage\n")
    endif()
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DPROJECT_SOURCE_DIR=${fixtureRoot}"
            -P "${CMAKE_CURRENT_LIST_DIR}/CheckNoPlaybackQImage.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    if(case STREQUAL "clean")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${case}: clean sources rejected: ${output}\n${errors}")
        endif()
    elseif(case STREQUAL "missing-relay")
        if(result EQUAL 0 OR NOT errors MATCHES "Required playback QImage check anchor is missing")
            message(FATAL_ERROR "${case}: missing anchor not diagnosed: ${output}\n${errors}")
        endif()
    else()
        if(case STREQUAL "relay-qimage")
            set(expectedFile "RenderAckRelay.cpp")
        else()
            set(expectedFile "GpuTransferActor.cpp")
        endif()
        if(result EQUAL 0 OR NOT errors MATCHES "QImage is forbidden" OR
           NOT errors MATCHES "${expectedFile}")
            message(FATAL_ERROR "${case}: violation not diagnosed: ${output}\n${errors}")
        endif()
    endif()
    message(STATUS "PASS: ${case}")
endforeach()
if(NOT checkCount EQUAL 4)
    message(FATAL_ERROR "Expected four playback QImage contract cases; ran ${checkCount}.")
endif()
