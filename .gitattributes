* text=auto

# Repository text uses LF; Windows-only command scripts use CRLF.
.clang-format text eol=lf
.clang-tidy text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.hlsl text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.qml text eol=lf
*.qrc text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ui text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Media, images, fonts, executables, and packages are binary.
*.aac binary
*.avi binary
*.dll binary
*.exe binary
*.gif binary
*.h264 binary
*.h265 binary
*.hevc binary
*.ico binary
*.jpg binary
*.jpeg binary
*.m4v binary
*.mkv binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.msi binary
*.pdb binary
*.pdf binary
*.png binary
*.qm binary
*.qsb binary
*.tif binary
*.tiff binary
*.ttf binary
*.wav binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.png filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
